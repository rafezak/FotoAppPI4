<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FotoApp.Views.CreateAssignment"
             Title="CreateAssignment">

    <StackLayout Padding="20">
        <!-- Title Input -->
        <Label Text="Assignment Title" />
        <Entry x:Name="TitleEntry" Placeholder="Enter title" />

        <!-- Description Input -->
        <Label Text="Description" />
        <Entry x:Name="DescriptionEditor" Placeholder="Enter description" />

        <!-- Due Date Input -->
        <Label Text="Due Date" />
        <DatePicker x:Name="DueDatePicker" />

        <!-- Theme Picker -->
        <Label Text="Select Theme" />
        <Picker x:Name="ThemePicker"
                Title="Select a theme"
                ItemDisplayBinding="{Binding Name}" />

        <!-- Submit Button -->
        <Button Text="Create Assignment"
                Clicked="OnCreateAssignmentClicked"
                BackgroundColor="Blue"
                TextColor="White" />
    </StackLayout>

</ContentPage>