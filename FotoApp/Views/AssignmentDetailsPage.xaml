<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FotoApp.Views.AssignmentDetailsPage"
             Title="AssignmentDetailsPage">
    
    <ScrollView>
        <StackLayout Padding="10">
            <Label Text="Description" FontAttributes="Bold" FontSize="18"/>
            <Label Text="{Binding Description}" FontSize="16" />

            <Label Text="Themes" FontAttributes="Bold" FontSize="18"/>
            <CollectionView ItemsSource="{Binding Themes}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Label Text="{Binding Name}" FontSize="16" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>


            <Button
                x:Name="JoinAssignmentButton"
                Text="Join Assignment"
                Clicked="JoinAssignmentButton_Clicked"
                
                BackgroundColor="Green"
                TextColor="White"
                Margin="0,20,0,0" />


            <Button
                x:Name="UploadPictureButton"
                Text="Upload Picture"
                Clicked="OnUploadPictureClicked"
                BackgroundColor="DodgerBlue"
                TextColor="White"
                Margin="10"/>
            
            <CollectionView x:Name="PicturesCollectionView">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Image Source="{Binding FilePath}" HeightRequest="100" WidthRequest="100" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </StackLayout>
    </ScrollView>
</ContentPage>