<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FotoApp.Views.HomePage"
             Title="HomePage">


    <ContentPage.Content>
        <ScrollView>
            <StackLayout Padding="20" Spacing="20">

                <!-- Logo -->
                <Image Source="app_logo.png" 
                   HeightRequest="100" 
                   HorizontalOptions="Center" />

                <!-- Welcome Text -->
                <Label Text="Welcome to FotoApp" 
                   FontSize="32" 
                   TextColor="White" 
                   HorizontalOptions="Center"
                   FontAttributes="Bold" />

                <Label Text="Capture and Share Photos with the World!" 
                   FontSize="16" 
                   TextColor="#AAAAAA" 
                   HorizontalOptions="Center" />

                <!-- Feature Buttons -->
                <Button
                    x:Name="assignmentButton"
                    Text="📷 View Assignments"
                    FontSize="18"
                    TextColor="White"
                    BackgroundColor="#4CAF50"
                    CornerRadius="10"
                    HeightRequest="50"
                    Clicked="assignmentButton_Clicked"
                     />

                <Button 
                    x:Name="feedButton"
                    Text="📰 View Feed"
                    FontSize="18"
                    TextColor="White"
                    BackgroundColor="#2196F3"
                    CornerRadius="10"
                    HeightRequest="50"
                   Clicked="feedButton_Clicked" />


                <Button
                    x:Name="adminButton"
                    Text="⚙️ Admin Configuration"
                    FontSize="18"
                    TextColor="White"
                    BackgroundColor="#FF5722"
                    CornerRadius="10"
                    HeightRequest="50"
                    Clicked="adminButton_Clicked"
                    IsVisible="{Binding IsAdmin}" />

                <!-- Divider -->
                <BoxView HeightRequest="2" 
                     BackgroundColor="#444444" 
                     HorizontalOptions="Fill" />

                <!-- Information Section -->
                <Label Text= "Discover various photos and share your own special photos with the community!"
                   FontSize="16"
                   TextColor="#AAAAAA"
                   HorizontalOptions="Center"
                   LineBreakMode="WordWrap"
                   HorizontalTextAlignment="Center" />

                <Label Text="Let your creativity shine with FotoApp!"
                   FontSize="16"
                   TextColor="#AAAAAA"
                   HorizontalOptions="Center"
                   LineBreakMode="WordWrap"
                   HorizontalTextAlignment="Center" />

            </StackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>
