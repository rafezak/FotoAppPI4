<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FotoApp.Views.HomePage"
             Title="HomePage">


    <ContentPage.Content>
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="20">

                <!-- Logo -->
                <Image Source="app_logo.png" 
                   HeightRequest="100" 
                   HorizontalOptions="Center" />

                <!-- Welcome Text -->
                <Label Text="Welcome to FotoApp" 
                   FontSize="32" 
                   TextColor="White" 
                   HorizontalOptions="Center"
                   FontAttributes="Bold" />

                <Label Text="Maak en Deel Foto's met de rest van de Wereld!" 
                   FontSize="16" 
                   TextColor="#AAAAAA" 
                   HorizontalOptions="Center" />

                <!-- Feature Buttons -->
                <Button Text="📷 Upload een Foto"
                    FontSize="18"
                    TextColor="White"
                    BackgroundColor="#4CAF50"
                    CornerRadius="10"
                    HeightRequest="50"
                     />

                <Button Text="📰 Bekijk Feed"
                    FontSize="18"
                    TextColor="White"
                    BackgroundColor="#2196F3"
                    CornerRadius="10"
                    HeightRequest="50"
                     />

                <Button Text="⚙️ Admin Configuratie"
                    FontSize="18"
                    TextColor="White"
                    BackgroundColor="#FF5722"
                    CornerRadius="10"
                    HeightRequest="50"
                    
                    IsVisible="{Binding IsAdmin}" />

                <!-- Divider -->
                <BoxView HeightRequest="2" 
                     BackgroundColor="#444444" 
                     HorizontalOptions="Fill" />

                <!-- Information Section -->
                <Label Text= "Ontdek diverse foto's and deel je eigen speciale Foto's met de rest van de community!"
                   FontSize="16"
                   TextColor="#AAAAAA"
                   HorizontalOptions="Center"
                   LineBreakMode="WordWrap"
                   HorizontalTextAlignment="Center" />

                <Label Text="laat je creativiteit schijnen met FotoApp!"
                   FontSize="16"
                   TextColor="#AAAAAA"
                   HorizontalOptions="Center"
                   LineBreakMode="WordWrap"
                   HorizontalTextAlignment="Center" />

            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>
